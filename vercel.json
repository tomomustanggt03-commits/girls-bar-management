{
  "cleanUrls": true,
  "routes": [
    {"src":"^/$","dest":"/api/app"},
    {"handle":"filesystem"},
    {"src":"/(.*)","dest":"/$1"}
  ],
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Frame-Options","value":"DENY"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"}]}]
}